{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://placeprep-api-production-2481.up.railway.app/api/$1"
    },
    {
      "source": "/mcp",
      "destination": "https://placeprep-api-production-2481.up.railway.app/mcp"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "https://placeprep-api-production-2481.up.railway.app/mcp/$1"
    },
    {
      "source": "/oauth/(.*)",
      "destination": "https://placeprep-api-production-2481.up.railway.app/oauth/$1"
    },
    {
      "source": "/.well-known/(.*)",
      "destination": "https://placeprep-api-production-2481.up.railway.app/.well-known/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://placeprep-api-production-2481.up.railway.app/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
