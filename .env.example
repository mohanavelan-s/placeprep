# ------------------------------------------------------------------------------
# PlacePrep Frontend Environment Configuration
# ------------------------------------------------------------------------------
# For local development with Vite dev proxy:
VITE_API_URL=http://127.0.0.1:5000/api

# For Vercel production deployment with rewrites:
# VITE_API_URL=/api

# For direct remote HTTPS backend:
# VITE_API_URL=https://<your-cloud-run-service>.a.run.app/api

# Optional comma-separated fallback URLs (leave empty in production)
VITE_API_FALLBACK_URLS=

# Public MCP origin (used by MCP Gateway docs & snippet generator)
# VITE_MCP_PUBLIC_URL=https://<your-cloud-run-service>.a.run.app

# Google OAuth Web Client ID for Sign-In
VITE_GOOGLE_CLIENT_ID=
