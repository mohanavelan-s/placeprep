# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/placeprep
DB_HOST=localhost
DB_PORT=5432
DB_NAME=placeprep
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI provider
# For OpenRouter, paste your sk-or-v1 key below and keep the OpenRouter base URL.
OPENAI_API_KEY=sk-or-v1-your_openrouter_api_key
OPENAI_MODEL=openai/gpt-5.5-pro
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1

# Frontend URL (CORS)
CLIENT_URL=http://127.0.0.1:4173
CLIENT_URLS=http://127.0.0.1:4173,https://placeprep.vercel.app
APP_URL=http://127.0.0.1:4173
NGROK_URL=

# Runtime
DEFAULT_TIMEZONE=Asia/Calcutta
AUTO_INIT_DB=true
MAX_UPLOAD_FILE_SIZE=8388608
MAX_APK_UPLOAD_FILE_SIZE=157286400
UPLOAD_DIR=./uploads
ALLOW_PUBLIC_SIGNUP=false
BOOTSTRAP_ADMIN_INVITE_CODE=
BOOTSTRAP_OBSERVER_INVITE_CODE=
BOOTSTRAP_USER_INVITE_CODE=
BOOTSTRAP_INVITE_CODE=
BOOTSTRAP_INVITE_ROLE=admin
BOOTSTRAP_INVITE_EXPIRES_DAYS=14

# Notifications
NOTIFICATION_SCHEDULER_ENABLED=true
# Sweep every 15 minutes; users are deduped into morning/evening/idle windows.
NOTIFICATION_CRON=*/15 * * * *
NOTIFICATION_SWEEP_CRON=*/15 * * * *
NOTIFICATION_MORNING_HOUR=8
NOTIFICATION_EVENING_HOUR=20
NOTIFICATION_SLOT_WINDOW_MINUTES=75
DELIVERY_WORKER_ENABLED=true
DELIVERY_WORKER_CRON=*/1 * * * *
DELIVERY_WORKER_BATCH_SIZE=12

# Judge0 sandbox execution
JUDGE0_ENABLED=true
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_RAPIDAPI_HOST=
# Preferred aliases shown first; PlacePrep also exposes every non-archived Judge0 provider language.
JUDGE0_ALLOWED_LANGUAGES=python,javascript,typescript,c,cpp,java,go,rust,csharp,mysql,postgresql
JUDGE0_CPU_TIME_LIMIT=2
JUDGE0_WALL_TIME_LIMIT=5
JUDGE0_MEMORY_LIMIT_KB=128000
JUDGE0_MAX_SOURCE_BYTES=20000
JUDGE0_MAX_STDIN_BYTES=4000
JUDGE0_POLL_TIMEOUT_MS=20000

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FORCE_IPV4=true
SMTP_CONNECTION_TIMEOUT_MS=30000
SMTP_USER=your_email_username
SMTP_PASS=your_email_password_or_app_password
SMTP_FROM="PlacePrep <noreply@placeprep.local>"
INVITE_SIGNUP_NOTIFY_EMAIL=your_admin_email@example.com

# Railway note: SMTP_FROM can be the same mailbox as SMTP_USER.
# The server also accepts SMPT_HOST/SMPT_PORT/SMPT_USER/SMPT_PASS/SMPT_FROM
# in case the Railway variables were created with the common SMPT typo.

# Browser push (VAPID)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:security@placeprep.local
