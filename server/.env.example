# ==============================================================================
# PlacePrep Spring Boot Backend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME (Configuration)
# ------------------------------------------------------------------------------
# In Cloud Run, PORT is injected automatically (typically 8080).
PORT=8080
SPRING_PROFILES_ACTIVE=prod
DEFAULT_TIMEZONE=Asia/Calcutta
UPLOAD_DIR=/tmp/uploads
ALLOW_PUBLIC_SIGNUP=false

# ------------------------------------------------------------------------------
# 2. DATABASE / SUPABASE (Secrets & Connection Pool)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL connection string (Transaction pooler or Session pooler)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=
# For Cloud Run auto-scaling, keep connection pool small per instance (e.g. 5)
DB_POOL_MAX=5
DB_POOL_MIN=1
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=30000
DB_MAX_LIFETIME=1800000

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT (Secrets)
# ------------------------------------------------------------------------------
# High-entropy secret key for symmetric user tokens (HS256)
JWT_SECRET=
JWT_EXPIRES_IN_MS=604800000

# Google OAuth Web Client ID (Public Web Client Identifier)
GOOGLE_CLIENT_ID=

# Bootstrap invite codes for initial administrator / member setup
BOOTSTRAP_ADMIN_INVITE_CODE=
BOOTSTRAP_USER_INVITE_CODE=

# ------------------------------------------------------------------------------
# 4. FRONTEND ORIGINS & CORS (Configuration)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS
CLIENT_URLS=https://placeprep-nine.vercel.app,https://placeprep.vercel.app
APP_URL=https://placeprep-nine.vercel.app

# ------------------------------------------------------------------------------
# 5. MCP & OAUTH 2.1 (Configuration & Persistent Signing Secret)
# ------------------------------------------------------------------------------
# Public HTTPS origin for the backend service (actual Cloud Run URL e.g. https://<service>.a.run.app)
MCP_PUBLIC_URL=https://<your-service-hash>.a.run.app
OAUTH_ISSUER=https://<your-service-hash>.a.run.app
OAUTH_RESOURCE=https://<your-service-hash>.a.run.app/mcp

# Persistent RSA Private Key (PKCS#8 PEM) for multi-instance Cloud Run signing.
# If omitted, an ephemeral key is generated in memory for local development.
OAUTH_PRIVATE_KEY_PEM=
OAUTH_KEY_ID=placeprep-oauth-key-1

# JSON allowlist of permitted OAuth clients and their exact redirect URIs
OAUTH_CLIENTS=[{"clientId":"claude-web","redirectUris":["https://claude.ai/api/mcp/oauth_callback"]},{"clientId":"chatgpt-web","redirectUris":["https://chatgpt.com/api/mcp/oauth_callback"]},{"clientId":"local-mcp-test","redirectUris":["http://127.0.0.1:3000/oauth/callback","http://localhost:3000/oauth/callback"]}]

# ------------------------------------------------------------------------------
# 6. AI PROVIDER (Secrets & Models)
# ------------------------------------------------------------------------------
AI_PROVIDER=openrouter
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-5.1
AI_BASE_URL=https://openrouter.ai/api/v1

# Optional Google Gemini fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ------------------------------------------------------------------------------
# 7. CODE EXECUTION SANDBOX (Judge0)
# ------------------------------------------------------------------------------
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# ------------------------------------------------------------------------------
# 8. PAYMENTS & BILLING (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 9. CLOUD STORAGE (Cloudinary - Optional Object Storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
